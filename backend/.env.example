APP_ENV=development
ENABLE_DEMO_AUTH=true
# Local demonstration only. Production requires >=48 random chars.
SECRET_KEY=please-set-a-random-secret-locally
DATABASE_URL=sqlite:///./community_health.db
WECHAT_APPID=
WECHAT_APPSECRET=
CORS_ORIGINS=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Private persistent volume; never use static/ or a publicly served directory.
REPORT_STORAGE_DIR=./private_reports
# Rate limits
# Max report uploads per user per hour (each upload persists up to 10 MiB and spawns a parser).
REPORT_UPLOAD_RATE_PER_HOUR=30

REPORT_WORKER_ENABLED=true

# CSP 白名单：控制台允许的外部图片/视频来源（CDN）
ASSET_CSP_ORIGINS=

# 字段加密密钥轮换（可选）：当前密钥换成新值后，把旧密钥放入 PREVIOUS（逗号分隔，最旧在前），
# 运行 python scripts/rotate_field_keys.py --check 直至 TOTAL 为 0，再移除旧密钥。见 scripts/rotate_field_keys.py。
# FIELD_ENCRYPTION_PREVIOUS_KEYS=
