APP_ENV=development
ENABLE_DEMO_AUTH=true
# Local demonstration only. Production requires >=48 random chars.
SECRET_KEY=please-set-a-random-secret-locally
DATABASE_URL=sqlite:///./community_health.db
WECHAT_APPID=
WECHAT_APPSECRET=
CORS_ORIGINS=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Private persistent volume; never use static/ or a publicly served directory.
REPORT_STORAGE_DIR=./private_reports
# One embedded DB-backed worker per web process; set false if running python -m app.report_worker separately.
REPORT_WORKER_ENABLED=true

# CSP 白名单：控制台允许的外部图片/视频来源（CDN）
ASSET_CSP_ORIGINS=
