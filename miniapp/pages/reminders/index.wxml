<view class="page"><view class="eyebrow">HEALTH ROUTINE</view><view class="title">健康事项提醒</view><view class="desc">把需要做的事情列出来，一件件完成。</view>
<view class="notice">当前版本的提醒只会在您打开小程序时显示待办。尚未接入微信订阅通知，不会向手机自动推送。</view>
<view class="card"><view class="card-title">新增待办</view><view class="label">事项名称</view><input class="input" value="{{title}}" bindinput="changeTitle" maxlength="120" placeholder="例如：明早测量血压"/><view class="label">事项类型</view><picker range="{{types}}" range-key="title" bindchange="chooseType"><view class="select">{{types[selected].title}} ▾</view></picker><view class="label">计划日期</view><picker mode="date" value="{{dueDate}}" bindchange="chooseDate"><view class="select">{{dueDate||'请选择日期'}} ▾</view></picker><button class="btn primary" bindtap="save">添加待办</button></view>
<view class="section-title">我的待办事项</view><view class="card"><view wx:for="{{list}}" wx:key="id" class="item row"><view><view class="item-title" style="opacity:{{item.completed_at?0.45:1}}">{{item.title}}</view><view class="item-sub">{{item.due_date}} · {{item.type_name}}</view></view><view wx:if="{{item.completed_at}}" class="badge">已完成</view><button wx:else class="btn small" data-id="{{item.id}}" bindtap="complete">完成</button></view><view wx:if="{{!list.length}}" class="empty">暂时没有待办事项</view></view></view>
