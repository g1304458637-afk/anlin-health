page{background:#f6f8f7;color:#203632;font-family:-apple-system,BlinkMacSystemFont,'PingFang SC',sans-serif;font-size:30rpx;line-height:1.55}.page{padding:32rpx 32rpx 80rpx}.logo{width:92rpx;height:92rpx;display:flex;align-items:center;justify-content:center;background:#dbece4;border-radius:27rpx;font-size:55rpx;color:#17695a}.eyebrow{font-size:21rpx;letter-spacing:5rpx;color:#21816b;font-weight:700}.title{font-size:47rpx;font-weight:700;letter-spacing:-1rpx;margin:12rpx 0}.desc{color:#73847e;font-size:26rpx;line-height:1.7}.card{background:#fff;border:1rpx solid #e7edea;border-radius:26rpx;padding:30rpx;margin-top:25rpx;box-shadow:0 10rpx 35rpx #1d483d08}.card-title{font-weight:700;font-size:33rpx;margin-bottom:17rpx}.label{display:block;font-size:25rpx;font-weight:600;color:#48645c;margin:22rpx 0 11rpx}.input{width:100%;box-sizing:border-box;min-height:92rpx;padding:15rpx 23rpx;border:2rpx solid #dde7e1;border-radius:18rpx;background:#fbfcfb;font-size:30rpx}.select{padding:20rpx 24rpx;background:#f8fbf9;border:2rpx solid #e0e8e2;border-radius:18rpx;min-height:53rpx}.btn{display:flex;align-items:center;justify-content:center;border-radius:20rpx;min-height:94rpx;font-size:29rpx;font-weight:650;margin-top:24rpx;background:#fff;color:#31564a;border:2rpx solid #d7e4db}.btn.primary{background:#176956;border-color:#176956;color:#fff}.btn.secondary{background:#e8f2ed;border-color:#e8f2ed;color:#226954}.btn.warn{border-color:#ead1d1;color:#a94343}.btn::after{border:0}.btn.small{min-height:62rpx;padding:0 22rpx;font-size:23rpx;margin:0;border-radius:13rpx}.row{display:flex;justify-content:space-between;align-items:center;gap:15rpx}.muted{color:#82918a;font-size:25rpx}.line{height:2rpx;background:#eaf0eb;margin:23rpx 0}.item{padding:24rpx 0;border-bottom:2rpx solid #eff3ef}.item:last-child{border:0}.item-title{font-weight:600;font-size:28rpx}.item-sub{font-size:24rpx;color:#82918a;margin-top:5rpx}.badge{font-size:21rpx;color:#23765d;background:#e3f3e9;padding:5rpx 13rpx;border-radius:99rpx}.hint{color:#7d8b84;font-size:22rpx;line-height:1.7;margin-top:23rpx}.notice{border:1rpx solid #dfebdf;background:#eff6ed;border-radius:19rpx;padding:23rpx;color:#497154;font-size:25rpx;line-height:1.7;margin-top:25rpx}.error{color:#b64143}.radio-label{display:flex;align-items:center;gap:16rpx;padding:23rpx 15rpx;font-size:27rpx;border-bottom:1rpx solid #edf0ed;min-height:60rpx}.choice{display:flex;align-items:center;gap:16rpx;padding:24rpx 14rpx;border:2rpx solid #e4ece7;border-radius:15rpx;margin-top:14rpx;font-size:26rpx}.choice.active{border-color:#21715c;background:#eaf4ed}.back{font-size:25rpx;color:#397a66;margin-bottom:14rpx}.empty{padding:45rpx 0;text-align:center;color:#8a9990;font-size:26rpx}.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.tile{border:1rpx solid #e6eee8;background:#fff;border-radius:20rpx;padding:29rpx;min-height:133rpx}.tile-icon{color:#1b715d;font-size:38rpx}.tile-title{font-weight:700;margin-top:8rpx}.tile-sub{font-size:22rpx;color:#81948a}.section-title{font-size:33rpx;font-weight:700;margin-top:40rpx;margin-bottom:12rpx}.summary{background:#1a5146;color:#fff;padding:35rpx;border-radius:25rpx;margin-top:30rpx}.summary .desc{color:#d1e3db}.checkbox-row{display:flex;gap:16rpx;align-items:flex-start;font-size:25rpx;color:#48645a;line-height:1.7;margin-top:25rpx}
